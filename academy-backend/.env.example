# Database (Prisma-owned Postgres — local dev instance or Cloud SQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/academy_dev

# Auth
ACADEMY_JWT_SECRET=replace-with-32-plus-random-bytes-base64
ACADEMY_JWT_TTL_SECONDS=86400

# Admin bootstrap credential (scrypt hash — generate with scripts/hash-admin-password.mjs)
ACADEMY_ADMIN_EMAIL=
ACADEMY_ADMIN_PASSWORD_HASH=

# Google Gemini
GEMINI_API_KEY=

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_PUBLIC_BUCKET=
GCS_PRIVATE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# CORS
CORS_ORIGIN=http://localhost:3000

# Server
PORT=4000
NODE_ENV=development
